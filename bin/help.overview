#!/usr/bin/env bash

version="${ASDF_INSTALL_VERSION:-}"

cat <<-EOF
Basic usage:

  asdf list all php
  asdf install php $version
  asdf global php $version

  php --version
  composer --version

Check the asdf documentation for more instructions on how to install & manage versions of PHP.

If you use Composer to install a global package that provides commands (e.g., friendsofphp/php-cs-fixer), you will need to run "asdf reshim php" for the binary to be in your path.
EOF
